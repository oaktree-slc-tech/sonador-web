[Site-Config]
SITE_ID = 1	# ID for the currently active site (primary key of the domain in the Django sites framework)
SITE_HAME = 'imaging'	# Domain of the website
SECRET_KEY = 'sonador-development-server'
INTERNAL_IPS = '*',
ALLOWED_HOSTS = '127.0.0.1', '.oak-tree.tech', 'imaging', 'sonador'
LOG_LEVEL_ROOT = 'DEBUG'	# Level of log detail: DEBUG, INFO, ERROR
LOG_LEVEL_CONSOLE = 'DEBUG'	# Level of log detail to output to console: DEBUG, INFO, ERROR
CSRF_TRUSTED_ORIGINS = 'http://imaging:8070', 


[Site-Connection]
SITE_CONNECT_SCHEME = 'https' # Site connection scheme (production)
SITE_CONNECT_PORT = '' # If different from http/https defaults (80/443)
SITE_CONNECT_SCHEME_DEVEL = 'http' # Connection connection scheme (development)
SITE_CONNECT_PORT_DEVEL = '8070' # Connection port (development)
SITE_CONNECT_MATCH_SITE_SCHEME = False
SITE_CONNECT_MATCH_SITE_NETLOC = False
BASE_URL = 'http://imaging:8070'


[Localization]
TIME_ZONE = 'America/Denver'
LANGUAGE_CODE = 'en-us'


[Databases]
[[default]]
ENGINE = 'django.db.backends.postgresql_psycopg2'
NAME = 'sonador'
USER = 'postgres'
PASSWORD = 'images-control@medical-db'
HOST = 'sonador-db'
PORT =  '5432'



[Database-Migrations]
secure = dbmigrations.secure
wgtsocial = dbmigrations.wgtauth.social
wgtregistration = dbmigrations.wgtauth.registration
visionaire = dbmigrations.visionaire
gateway = dbmigrations.gateway
auth = dbmigrations.auth
sites = dbmigrations.sites


[Authentication]
AUTH_ENABLED = True
SERVER_APITOKEN = api-application-token
AUTH_CREDENTIALS_CACHE = True

[Kafka]
KAFKA_BOOTSTRAP_SERVER = 'kafka:9092'
KAKFA_CLIENT_ID = 'Sonador'


[Resource-Files]
STATIC_ROOT = /srv/www/sonador/docroot/static/
MEDIA_ROOT = /srv/www/sonador/docroot/static/media/

[Storage]
OBJECT_STORAGE_TYPE = 's3-minio'


[S3]
AWS_S3_SERVICE_URL = 'http://object-storage:9000'
AWS_S3_ACCESS_ID = 'jupyter'
AWS_S3_SECRET_KEY = 'jupyter@analytics'
AWS_S3_REGION = 'us-east-1'
AWS_S3_STATIC_CONTAINER = 'sonador-static'
AWS_S3_MEDIA_CONTAINER = 'sonador-media'

[GCS]
GS_MEDIA_BUCKET = "sonador-media"
GS_STATIC_BUCKET = "sonador-static"
GS_PROJECTID = "sonador-XXXXX"
GS_CREDENTIALS_PATH = "path/to/credentials/file"
